{
  "name": "mamri",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "build:site": "nuxt build",
    "build:studio": "SANITY_STUDIO_BASEPATH=/admin npm --prefix studio-mamri run build",
    "build:netlify": "npm run build:site && SANITY_STUDIO_BASEPATH=/admin npm --prefix studio-mamri run build",
    "dev": "CHOKIDAR_USEPOLLING=1 nuxt dev",
    "dev:studio": "npm --prefix studio-mamri run dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "seed": "tsx scripts/seed-sanity.ts",
    "dump-snapshot": "tsx scripts/dump-snapshot.ts",
    "optimize-images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@nuxt/image": "^2.1.0",
    "@sanity/client": "^7.12.0",
    "@sanity/image-url": "^1.2.0",
    "groq": "^4.10.2",
    "nuxt": "^4.5.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5"
  }
}
